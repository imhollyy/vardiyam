{
  "expo": {
    "name": "Mesai Pusulası",
    "slug": "mesai-pusulasi",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "mesai-pusulasi",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F6F2EA",
    "ios": {
      "supportsTablet": true,
      "backgroundColor": "#F6F2EA"
    },
    "android": {
      "backgroundColor": "#F6F2EA"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-system-ui"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
