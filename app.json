{
  "expo": {
    "name": "Vardiyam",
    "slug": "vardiyam",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "vardiyam",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
